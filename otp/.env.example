# Copy to otp/.env and fill in — docker compose loads this automatically for
# `npm run otp:up` / `npm run otp:down` since it sits next to otp/docker-compose.yml.

# Host ports (defaults shown; change if already taken by something else on your host)
OTP_HOST_PORT=8095
COMMUTE_WORKER_PORT=8096

# Same Supabase project as the main app's .env.local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Shared secret — must match COMMUTE_WEBHOOK_SECRET in the Vercel project's env vars
COMMUTE_WEBHOOK_SECRET=

COMMUTE_GRID_SPACING_METERS=500

# Concurrent OTP requests during recompute — keep at/below your host's CPU count
COMMUTE_OTP_CONCURRENCY=3
